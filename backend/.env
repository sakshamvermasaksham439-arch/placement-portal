PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/placement_portal
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://127.0.0.1:5500
# Optional email notifications (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Placement Portal <no-reply@example.com>
# Used only by `npm test`
MONGO_URI_TEST=mongodb://127.0.0.1:27017/placement_test
